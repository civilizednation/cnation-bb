// cnation-project 전체 Firestore 보안 규칙 (2026-11-05 정리)
//
// 예전 규칙의 `match /{document=**} { allow read, write: if true; }` 는 모든 컬렉션을
// 누구에게나 열어서, 아래 붕어빵 규칙과 users 규칙을 무력화했다.
// 그 한 줄 대신, 지금 앱들이 쓰는 컬렉션을 하나씩 적어서 예전처럼 열어 둔다
// (각 앱의 동작은 그대로). 목록에 없는 컬렉션은 이제 닫힌다.
// 컬렉션 목록은 civilizednation 저장소의 코드에서 찾았다. 새 앱이 새 컬렉션을 쓰면 여기에 추가한다.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인한 본인만 (cnation-sts)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ───────── 기존 앱: 예전과 같이 열어 둠 ─────────
    match /cnation-snake-scores/{d=**}          { allow read, write: if true; }  // cnation-jgame
    match /cnation-4x4drum-scores/{d=**}        { allow read, write: if true; }  // cnation-4x4drum
    match /cnation-goodmento-students/{d=**}    { allow read, write: if true; }  // goodmento-school-check
    match /cnation-goodmento-schools/{d=**}     { allow read, write: if true; }
    match /cnation-goodmento-attendance/{d=**}  { allow read, write: if true; }
    match /family/{d=**}                        { allow read, write: if true; }  // cnation-wuxi
    match /places/{d=**}                        { allow read, write: if true; }
    match /cnation-family-birthdays/{d=**}      { allow read, write: if true; }  // family-birthdays
    match /cnation-ccm-list/{d=**}              { allow read, write: if true; }  // cnation-ccm-list, cnation-msyh-sgd
    match /cnation-msyh-sgd-visits/{d=**}       { allow read, write: if true; }  // cnation-msyh-sgd
    match /cnation-msyh-sgd-weekly/{d=**}       { allow read, write: if true; }
    match /cnation-msyh-sgd-video-listens/{d=**} { allow read, write: if true; }
    match /cnation-msyh-sgd-practice-clicks/{d=**} { allow read, write: if true; }
    match /cnation-msyh-sgd-fixed/{d=**}        { allow read, write: if true; }
    match /coverSongsConfig/{d=**}              { allow read, write: if true; }

    // ───────── 붕어빵 블록 시작 (docs/firestore.rules와 같음) ─────────
    function bbEntry(maxMoney) {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'money', 'sold', 'sat', 'ending', 'retry', 'date', 'createdAt'])
        && d.keys().hasAll(['name', 'money', 'date', 'createdAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 8
        && d.money is int && d.money > 0 && d.money <= maxMoney
        && d.date is string && d.date.size() <= 10
        && d.createdAt == request.time
        && (!('sold' in d) || (d.sold is int && d.sold >= 0 && d.sold <= 2000))
        && (!('sat' in d) || (d.sat is int && d.sat >= 0 && d.sat <= 100))
        && (!('ending' in d) || (d.ending is string && d.ending.size() <= 20))
        && (!('retry' in d) || d.retry is bool);
    }
    match /cnation-bb-rank-story/{id} {
      allow read: if true;
      allow create: if bbEntry(10000000);
      allow update, delete: if false;
    }
    match /cnation-bb-rank-bean/{id} {
      allow read: if true;
      allow create: if bbEntry(1000000);
      allow update, delete: if false;
    }
    match /cnation-bb-rank-mix/{id} {
      allow read: if true;
      allow create: if bbEntry(1000000);
      allow update, delete: if false;
    }
    // ───────── 붕어빵 블록 끝 ─────────
  }
}
